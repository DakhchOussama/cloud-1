# MariaDB Configuration
DB_NAME={{ db_name | default('wordpress') }}
DB_USER={{ db_user | default('wpuser') }}
DB_PASSWORD={{ db_password | default('SecurePassword123!') }}
DB_ROOT_PASSWORD={{ db_root_password | default('RootPassword123!') }}
DB_HOST=mariadb

# WordPress Configuration
WORDPRESS_DB_HOST=mariadb:3306
WORDPRESS_DB_NAME={{ db_name | default('wordpress') }}
WORDPRESS_DB_USER={{ db_user | default('wpuser') }}
WORDPRESS_DB_PASSWORD={{ db_password | default('SecurePassword123!') }}
WORDPRESS_TABLE_PREFIX=wp_

# WordPress Admin
WORDPRESS_ADMIN_USER={{ wp_admin_user | default('admin') }}
WORDPRESS_ADMIN_PASSWORD={{ wp_admin_password | default('AdminPass123!') }}
WORDPRESS_ADMIN_EMAIL={{ wp_admin_email | default('admin@example.com') }}

# WordPress Site
WORDPRESS_TITLE={{ wp_title | default('My WordPress Site') }}
WORDPRESS_URL={{ wp_url | default('https://localhost') }}

# Domain Configuration
DOMAIN_NAME={{ domain_name | default('localhost') }}
